 0;\n\nconst precoUnitarioFormatado = precoUnitario.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\nconst subtotalFormatado = subtotal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\n// 2. Usa o método .map() para transformar cada item do carrinho em uma string formatada.\n// Retorna a string no formato \"quantidade\"x - \"nome\".\nreturn `${item.qtd}x - ${item.nome} = ${precoUnitarioFormatado} *(${subtotalFormatado})*`;\n});\n// Neste ponto, 'itensFormatados' é um array como: [\"2x - Trufa de Morango\", \"1x - Combo Casal\"]\n\n// 3. Usa o método .join() para unir todas as strings do array com o separador \" | \".\nreturn itensFormatados.join('\\n\\n');\n}\n\n// --- Como usar no seu fluxo n8n ---\n\n// Pega o carrinho\\_json do item de entrada.\n// O seu carrinho pode estar como uma string JSON ou já como um objeto.\n// Este código lida com ambos os casos.\nlet carrinhoDoCliente;\ntry {\n// Tenta converter, caso seja uma string.\ncarrinhoDoCliente = (typeof $json.carrinho_json === 'string') ? JSON.parse($json.carrinho_json) : $json.carrinho_json;\n} catch (e) {\n// Se der erro na conversão, assume um carrinho vazio.\ncarrinhoDoCliente = [];\n}\n\n// Chama a função para formatar o carrinho.\nconst textoFormatado = formatarCarrinhoEmLinha(carrinhoDoCliente);\n\n// Adiciona o resultado à saída do nó para ser usado nos nós seguintes.\n$json.carrinho_em_linha = textoFormatado;\n\n// Retorna o item com a nova propriedade.\nreturn $json;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-208,0],"id":"15996519-8bc5-4116-b7e7-dc8342e14f4d","name":"pega carrinho"},{"parameters":{"method":"POST","url":"=https://chatwoot.thelordbot.online/api/v1/accounts/1/conversations/{{ $('dados').first().json.conversation_id }}/messages","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"bodyParameters":{"parameters":[{"name":"content","value":"=**Nome:** {{ $('dados').first().json.nome_cliente }}"},{"na