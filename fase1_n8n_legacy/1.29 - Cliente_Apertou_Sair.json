tem.itens_internos) {\n      somaItem(sub.id, sub.qtd);\n    }\n  }\n}\n\n// 3. Converter objeto → array\nconst itensConsolidados = Object.entries(agrupados).map(([id, qtd]) => ({\n  id,\n  qtd\n}));\n\nreturn [{\n  json: {\n    Jid: sessao.jid,\n    telefone_real: sessao.telefone_real,\n    nome_cliente: sessao.nome_cliente,\n    itens: itensConsolidados,\n    print_carrinho: sessao.print_carrinho\n  }\n}];"},"id":"a781f4c0-4754-41f7-b51d-fa68c31ee476","name":"3. Code: Extrai Itens do Carrinho1","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1264,1024]},{"parameters":{"operation":"send","phoneNumberId":"1106879685852854","recipientPhoneNumber":"={{ $json.telefone_real ? $json.telefone_real : $json.Jid}}","textBody":"=_*👸🏾 Kakaw - TheLordTrufas.*_\n\n_*{{ $json.primeiro_nome }}*_, \nobrigado pela visita!\nEsperamos que volte logo\npara saborear uma de\nnossas deliciosas \n*Trufas de Colher* 🤗.\n\nE claro, não esqueça\nde seguir a *@thelordtrufas*\nnas Redes Sociais:\n\n📲🔗 → http://www.thelordtrufas.com.br/links\n\nThaw e até mais!!! 👋🤎\n\n\nAtendimento Encerrado.","additionalFields":{}},"type":"n8n-nodes-base.whatsApp","typeVersion":1,"position":[-2080,1040],"id":"87b9c2c6-1013-483e-9357-7b1fa2354037","name":"Send message","webhookId":"ee7d0421-ec8c-4da8-a11c-6682fc5e141b","credentials":{"whatsAppApi":{"id":"Qg8JgwRkGVCClGR2","name":"WhatsApp account"}}},{"parameters":{"resource":"databasePage","operation":"getAll","databaseId":{"__rl":true,"value":"00bbf526-fa59-4184-a47b-be954cb01d36","mode":"list","cachedResultName":"_Recuperação de Vendas","cachedResultUrl":"https://www.notion.so/00bbf526fa594184a47bbe954cb01d36"},"returnAll":true,"filterType":"manual","matchType":"allFilters","filters":{"conditions":[{"key":"Whatsapp|number","condition":"equals","numberValue":"={{ $('3. Code: Extrai Itens do Carrinho1').first().json.Jid.toNumber() }}"},{"key":"Enviado|checkbox","condition":"equals"}]},"options":{}},"type":"n8n-nodes-base.notion","typeVersion":2.2,"po