{"id":"kB19nYkDACENprqt","name":"1.11.4 - Montando o Combo Cupom","active":false,"activeVersionId":null,"createdAt":"2026-07-20T00:43:56.311Z","updatedAt":"2026-07-20T14:06:42.964Z","isArchived":false,"versionId":"5057dce0-7b74-4810-af66-933cfe446bb1","triggerCount":0,"nodes":[{"parameters":{"jsCode":"// --- PASSO A: SELECIONAR ITEM DO COMBO (FLUXO ÚNICO) ---\n\nconst estadoAtual = $items(\"Start\")[0].json;\nconst mensagemCliente = $json.mensagem_cliente?.toString().trim();\nconst jid = estadoAtual.Jid;\n\n// --- Parse seguro ---\nlet combo = {};\nlet mapaId = {};\n\ntry {\n    combo = typeof estadoAtual.combo_em_montagem === 'string'\n        ? JSON.parse(estadoAtual.combo_em_montagem)\n        : estadoAtual.combo_em_montagem;\n\n    mapaId = typeof estadoAtual.mapa_id_json === 'string'\n        ? JSON.parse(estadoAtual.mapa_id_json)\n        : estadoAtual.mapa_id_json;\n\n} catch {\n    return [{\n        json: {\n            erro: true,\n            mensagemResposta: \"Erro técnico. Reiniciando.\",\n            sql: `UPDATE conversas_bot\n                  SET estado_conversa='menu_inicio',\n                      combo_em_montagem=NULL\n                  WHERE jid='${jid}'`\n        }\n    }];\n}\n\n\n// --- Item escolhido ---\nconst itemEscolhido = mapaId[mensagemCliente];\n\nif (!itemEscolhido) {\n    return [{\n        json: {\n            erro: true,\n            mensagemResposta: \"Opção inválida.\",\n            sql: null\n        }\n    }];\n}\n\n\n// --- Etapa atual ---\nconst etapaAtual = combo.etapas?.[combo.etapaAtual];\n\nif (!etapaAtual) {\n    return [{\n        json: {\n            erro: true,\n            mensagemResposta: \"Erro na montagem do combo.\",\n            sql: null\n        }\n    }];\n}\n\n\n// --- Limites ---\nconst escolhidos = etapaAtual.escolhidos || [];\n\nconst faltamNaEtapa =\n    (etapaAtual.quantidade || 1) - escolhidos.length;\n\n\n// Regra por sabor\nlet limiteRegra = Infinity;\n\nif (etapaAtual.regra?.includes('_por_sabor')) {\n    const limite = parseInt(etapaAtual.regra.split('_')[0], 10);\n\n    const jaTem =\n        escolhidos.filter(i => i.id === itemEscolhido.id).length;\n\n    limiteRegra = limite - jaTem;\n}\n\n\n// Estoque\nconst estoque = parseInt(itemEscolhido.estq || 0, 10);\n\nconst jaNoCombo =\n    escolhidos.filter(i => i.id === itemEscolhido.id).length;\n\nconst estoqueDisponivel = estoque - jaNoCombo;\n\n\n// Limite final\nconst maximoPermitido = Math.min(\n    faltamNaEtapa,\n    limiteRegra,\n    estoqueDisponivel\n);\n\n\nif (maximoPermitido <= 0) {\n    return [{\n        json: {\n            erro: true,\n            mensagemResposta:\n              `⚠️ Limite atingido para *${itemEscolhido.nome}*.`,\n            sql: null\n        }\n    }];\n}\n\n\n// =====================================================\n// 👉 ITEM PENDENTE (SEMPRE)\n// =====================================================\n\nconst itemPendente = {\n    id: itemEscolhido.id,\n    nome: itemEscolhido.nome,\n    preco: itemEscolhido.preco,\n    max_qtd: maximoPermitido\n};\n\n\n// Flag se regra for 1_por_sabor\nconst pularQtd = etapaAtual.regra === '1_por_sabor';\n\n\n// Mensagem padrão\nconst avisoExtra =\n    maximoPermitido === 1\n        ? \"\\n_(Quantidade máxima 1)_\"\n        : `\\n_(Quantidade máxima ${maximoPermitido})_`;\n\nreturn [{\n    json: {\n        sucesso: true,\n        pular_qtd: pularQtd,   // <<< AQUI\n        mensagemResposta:\n            `Quantas unidades de *${itemEscolhido.nome}*?${avisoExtra}`,\n        sql: `UPDATE conversas_bot\n              SET estado_conversa='montando_combo_qtd',\n                  item_pendente_combo='${JSON.stringify(itemPendente)}'::jsonb,\n                  ultima_interacao=NOW()\n              WHERE jid='${jid}'`\n    }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-464,128],"id":"52e4ccf4-7025-4042-8bce-fde5cb9d15c7","name":"Code in JavaScript"},{"parameters":{"inputSource":"passthrough"},"type":"n8n-nodes-base.executeWo