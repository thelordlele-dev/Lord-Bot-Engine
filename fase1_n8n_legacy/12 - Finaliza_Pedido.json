edido O valor total do pedido a ser verificado.\n * @returns {number|null} Retorna 5, 10 ou null se nenhum limite for atingido.\n */\nfunction calcularPontuacaoDoPedido(valorDoPedido) {\n  // --- Defina seus limites aqui ---\n  const limiteBaixo = 25.00;  // Acima deste valor, retorna 05\n  const limiteMedio = 40.00; // Acima deste valor, retorna 07\n  const limiteAlto = 80.00; // Acima deste valor, retorna 10\n  //const limiteExtra = 120.00; // Acima deste valor, retorna 12\n  // ---------------------------------\n\n  // 1. Primeiro, verifica se o valor ultrapassa o limite SUPERIOR.\n  //if (valorDoPedido > limiteExtra) {\n  //  return 12;\n  //}\n\n  if (valorDoPedido > limiteAlto) {\n    return 10;\n  }\n\n  // 2. Primeiro, verifica se o valor ultrapassa o limite SUPERIOR.\n  if (valorDoPedido > limiteMedio) {\n    return 07;\n  }\n\n  // 3. Se não passou no primeiro teste, verifica se ultrapassa o limite INFERIOR.\n  if (valorDoPedido > limiteBaixo) {\n    return 05;\n  }\n\n  // 4. Se não for maior que nenhum dos limites, não retorna nada.\n  return null;\n}\n\n// --- Minimo do próximo pedido ---\nfunction calcularMinimoDoPedido(valorDoPedido) {\n  // --- Defina seus limites aqui ---\n  const limiteBaixo = 25.00;  // Acima deste valor, retorna 25\n  const limiteMedio = 40.00; // Acima deste valor, retorna 40\n  const limiteAlto = 80.00; // Acima deste valor, retorna 80\n  //const limiteExtra = 120.00; // Acima deste valor, retorna 120\n  // ---------------------------------\n\n  // 1. Primeiro, verifica se o valor ultrapassa o limite SUPERIOR.\n  //if (valorDoPedido > limiteExtra) {\n  //  return 120.00;\n  //}\n\n  if (valorDoPedido > limiteAlto) {\n    return 80.00;\n  }\n\n  // 2. Primeiro, verifica se o valor ultrapassa o limite SUPERIOR.\n  if (valorDoPedido > limiteMedio) {\n    return 40.00;\n  }\n\n  // 3. Se não passou no primeiro teste, verifica se ultrapassa o limite INFERIOR.\n  if (valorDoPedido > limiteBaixo) {\n    return 25.00;\n  }\n\n  // 4. Se não for maior que nenhum dos limites, não retorna nada.\n  return null;\n}\n\n// --- Validade Cupom ---\nfunction calcularValidadeDoCupom(valorDoPedido) {\n  // --- Defina seus limites aqui ---\n  const limiteBaixo = 25.00;  // Acima deste valor, retorna 14\n  const limiteMedio = 40.00; // Acima deste valor, retorna 20\n  const limiteAlto = 80.00; // Acima deste valor, retorna 30\n  //const limiteExtra = 120.00; // Acima deste valor, retorna 45\n  // ---------------------------------\n\n  // 1. Primeiro, verifica se o valor ultrapassa o limite SUPERIOR.\n  //if (valorDoPedido > limiteExtra) {\n  //  return 45;\n  //}\n\n    if (valorDoPedido > limiteAlto) {\n    return 30;\n  }\n\n  // 2. Primeiro, verifica se o valor ultrapassa o limite SUPERIOR.\n  if (valorDoPedido > limiteMedio) {\n    return 20;\n  }\n\n  // 3. Se não passou no primeiro teste, verifica se ultrapassa o limite INFERIOR.\n  if (valorDoPedido > limiteBaixo) {\n    return 14;\n  }\n\n  // 4. Se não for maior que nenhum dos limites, não retorna nada.\n  return null;\n}\n\n// --- Como usar no seu fluxo n8n ---\n\n// Supondo que o valor total do seu pedido está em uma variável de entrada.\n// Exemplo: $json.total_valor = 75.50\nconst valorTotalDoPedido = valor_pedido;\n// Chama a função e armazena o resultado.\nconst resultado = calcularPontuacaoDoPedido(valorTotalDoPedido);\nconst minimo = calcularMinimoDoPedido(valorTotalDoPedido);\nconst validade = calcularValidadeDoCupom(valorTotalDoPedido);\n\n// Você pode então adicionar o resultado ao item para usar nos próximos nós.\n$json.desconto = resultado;\n$json.minimo = minimo;\n$json.validade = validade;\n\n// Retorna o item com a nova propriedade 'pontuacao'.\nreturn $json;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[896,0],"id":"1a939e6c-ddc3-427e-85a7-b751100ad574","name":"qual_desconto","alwaysOutputData":false},{"parameters":{"operation":"send","phoneNumberId":"1106879685852854","recipientPhoneNumber":"={{ $json.telefone_real ? $js