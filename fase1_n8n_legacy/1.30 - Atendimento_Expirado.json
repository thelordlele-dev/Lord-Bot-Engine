on: {\n    Jid: sessao.jid,\n    nome_cliente: sessao.nome_cliente,\n    telefone_real: sessao.telefone_real,\n    itens: itensConsolidados,\n    print_carrinho: sessao.print_carrinho\n  }\n}];"},"id":"1b0b192b-2d78-49e0-8f1c-6be2a04cc296","name":"3. Code: Extrai Itens do Carrinho1","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1488,784]},{"parameters":{"operation":"executeQuery","query":"UPDATE conversas_bot SET estado_conversa = 'cliente_existe', cupom_promo = NULL, print_carrinho = NULL, carrinho_json = '[]', mapa_id_json = '{}', pagina_atual = 1, categoria_selecionada = NULL, expirando = FALSE, is_bot_paused = FALSE, valor_pedido = NULL WHERE jid = '{{ $('3. Code: Extrai Itens do Carrinho1').first().json.Jid }}'","options":{}},"id":"dbcb04b5-be43-48be-b6f7-fc0b352aba43","name":"5. Postgres: Reseta o Estado da Conversa2","type":"n8n-nodes-base.postgres","typeVersion":2,"position":[-304,480],"credentials":{"postgres":{"id":"yOeDpA5WGlK3MxCC","name":"Postgres account"}}},{"parameters":{"method":"POST","url":"https://graph.facebook.com/v25.0/1106879685852854/messages","authentication":"predefinedCredentialType","nodeCredentialType":"whatsAppApi","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $('Filter').first().json.telefone_real ? $('Filter').first().json.telefone_real : $('Filter').first().json.jid }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"preview_url\": false,\n    \"body\": \"_*👸🏾 Kakaw - TheLordTrufas.*_\\n\\n_*{{ $('Filter').first().json.primeiro_nome }}*_,\\nvocê ainda está aí?\\n\\nCaso não haja interação nos\\npróximos *10 MINUTOS* seu\\natendimento será *ENCERRADO*\\nautomaticamente. 😕\"\n  }\n}","options":{"redirect":{"redirect":{}}}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-3360,800],"id":"bb32c542-c55b-4117-91da-e29f787c1c5f","name":"mensagem 5 min","executeOnce":true,"credentials":{"whatsAppApi":{"id":"Qg8Jg