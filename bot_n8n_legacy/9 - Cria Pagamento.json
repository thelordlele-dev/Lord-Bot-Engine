riedade.\nreturn $json;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[704,0],"id":"ecb4781c-3b4b-4942-86c6-3377d4b8fad5","name":"formata carrinho"},{"parameters":{"operation":"update","schema":{"__rl":true,"mode":"list","value":"public"},"table":{"__rl":true,"value":"pedidos","mode":"list","cachedResultName":"pedidos"},"columns":{"mappingMode":"defineBelow","value":{"id_pagamento":"={{ $('Cria Link').first().json.link.split('/')[4] }}","data_criacao":"={{ $now }}","reference_payment":"={{ $('Cria Link').first().json.details.orderNumber }}","numero_pedido":"={{ $('formata carrinho').first().json.numero_pedido }}","status_pagamento":"link_criado","status_pedido":"PAGAMENTO_PENDENTE"},"matchingColumns":["numero_pedido"],"schema":[{"id":"jid","displayName":"jid","required":true,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":true},{"id":"nome_cliente","displayName":"nome_cliente","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":true},{"id":"primeiro_nome","displayName":"primeiro_nome","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":true},{"id":"cpf","displayName":"cpf","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":true},{"id":"email","displayName":"email","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":true},{"id":"telefone_real","displayName":"telefone_real","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":true},{"id":"carrinho_json","displayName":"carrinho_json","required":false,"defaultMatch":false,"display":true,"type":"object","canBeUsedToMatch":true,"removed":true},{"id":"valor_total","displayName":"valor_total","required":false,"defaultMatch":false,"display":true,"type":"number","canBeUsedToMatch":true,"removed":true},{"id":"cupom_promo","disp