"typeVersion":2.2,"position":[720,224],"id":"f8010372-31fc-4792-bc43-72bd7494b43d","name":"4. Notion: Devolve Item ao Estoque1","credentials":{"notionApi":{"id":"vIevXLmWaO4BFYFE","name":"Notion account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"d428117c-2238-45e2-bf7d-6b5400a50c50","leftValue":"={{ $json.property_tipo }}","rightValue":"Individuais","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[352,400],"id":"0937d80a-00eb-463c-a3e0-5e54258a0e21","name":"If2"},{"parameters":{"resource":"databasePage","operation":"update","pageId":{"__rl":true,"value":"={{ $json.id }}","mode":"id"},"propertiesUi":{"propertyValues":[{"key":"Estoque|number","numberValue":"={{ $json.property_estoque + $('Split Out2').item.json.quantidade }}"}]},"options":{}},"type":"n8n-nodes-base.notion","typeVersion":2.2,"position":[1440,464],"id":"dc5af11d-a716-49cb-9817-e9e82c94b446","name":"atualiza_estoque6","credentials":{"notionApi":{"id":"vIevXLmWaO4BFYFE","name":"Notion account"}}},{"parameters":{"fieldToSplitOut":"page_id_para_atualizar","include":"selectedOtherFields","fieldsToInclude":"quantidade","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[960,464],"id":"76b9a729-4a3d-4368-8a5e-27b397b67501","name":"Split Out2"},{"parameters":{"jsCode":"// Este código recebe a lista COMPLETA de itens do nó anterior (ex: Notion).\n// Ele irá mapear as quantidades para cada item e, em seguida,\n// passará uma lista de pares (ID, Quantidade) para o &#39;Split Out&#39;.\n\n// 1. Pega TODOS os itens que vêm do nó anterior.\nconst todosOsItens = $input.all();\n\n// 2. Validação: Verifica se há itens.\nif (todosOsItens.length === 0) {\nconsole.warn(\"Nenhum item recebido do nó anterior.\");\nreturn []; // Não há o que processar\n}\n\n// 3. Pega os dados do PRIMEIRO item (o combo).\n//    Este código assume que você está a processar UM combo de cada vez.\nconst combo = todosOsItens[0].json;\n\nconst idArray = combo.property_relacionadas; // Este já é um array\nconst quantityString = combo.property_quantidades; // Este é \"2,1,2,1\"\n\n// 4. Validação básica para evitar erros\nif (!idArray || !quantityString || idArray.length === 0) {\nconsole.warn(\"Item pulado: IDs da Relação ou Texto de Quantidade estão vazios.\");\nreturn [];\n}\n\n// 5. Converte a string de quantidades num array.\nconst quantityArray = quantityString.split(',');\n\n// 6. Validação de segurança:\n//    Verifica se o número de IDs relacionados é o mesmo que o de quantidades.\nif (idArray.length !== quantityArray.length) {\nconsole.error(`ERRO: Descompasso no combo! IDs: ${idArray.length}, Quantidades: ${quantityArray.length}`);\nthrow new Error(\"O número de itens relacionados não é igual ao número de quantidades.\");\n}\n\n// 7. Cria a lista de novos itens (os pares)\nconst newItems = [];\nfor (let i = 0; i < idArray.length; i++) {\n\n// Pega o ID da relação do item atual. \n  const pageId = idArray[i];\n\n// Pega a quantidade correspondente da lista de quantidades, com base no índice.\n  const quantidade = parseInt(quantityArray[i].trim(), 10);\n\n// Cria o objeto de saída. \n  newItems.push({ json: { page_id_para_atualizar: pageId, quantidade: quantidade } });\n\n}\n\n// 8. Retorna a lista de pares (ID, Quantidade)\n// O próximo nó (Split Out) irá receber esta lista e executará um fluxo para cada item.\nreturn newItems;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[720,464],"id":"bdd91c5e-2b33-4ff5-93b0-57c682673808","name":"Code in JavaScript2"},{"parameters":{"resource":"databasePage","operation":"get","pageId":{"__rl":true,"value":"={{ $json.page_id_para_atualizar }}","mode":"id"}},"type":"n8n-nodes-base.notion","typeVersion":2.2,"position":[1184,464],"id":"664fea3f-52e0-4bfa-ae75-aa122788fd4d","name":"Get a database page2","credential