ue":"={{ $json.id }}","mode":"id"},"propertiesUi":{"propertyValues":[{"key":"Fluxo de Caixa|relation","relationValue":["={{ $('dados caixa').first().json.id }}"]}]},"options":{}},"type":"n8n-nodes-base.notion","typeVersion":2.2,"position":[3200,0],"id":"c99f8309-7bb6-4ee7-916e-a12de8985d2a","name":"atualiza cupons","alwaysOutputData":false,"credentials":{"notionApi":{"id":"vIevXLmWaO4BFYFE","name":"Notion account"}},"onError":"continueRegularOutput"},{"parameters":{"jsCode":"// --- CÓDIGO PARA FORMATAR O CARRINHO EM UMA ÚNICA LINHA ---\n\n/*\\*\n\n  * Pega um array de itens do carrinho e o formata numa única string.\n  * @param {Array} carrinho - O array de itens do carrinho, ex: [{qtd: 2, nome: \"Trufa\"}, ...].\n  * @returns {string} Uma string formatada, ex: \"2x - Trufa | 1x - Combo\".\n  */\n    function formatarCarrinhoEmLinha(carrinho) {\n    // 1. Validação: Se o carrinho não existir, não for um array ou estiver vazio, retorna uma string vazia.\n    if (!carrinho || !Array.isArray(carrinho) || carrinho.length === 0) {\n    return \"Carrinho vazio\";\n    }\n\n// 2. Usa o método .map() para transformar cada item do carrinho em uma string formatada.\nconst itensFormatados = carrinho.map(item => {\n// Retorna a string no formato \"quantidade\"x - \"nome\".\nreturn `${item.qtd}x - ${item.nome}`;\n});\n// Neste ponto, 'itensFormatados' é um array como: [\"2x - Trufa de Morango\", \"1x - Combo Casal\"]\n\n// 3. Usa o método .join() para unir todas as strings do array com o separador \" | \".\nreturn itensFormatados.join('\\n\\n');\n}\n\n// --- Como usar no seu fluxo n8n ---\n\n// Pega o carrinho\\_json do item de entrada.\n// O seu carrinho pode estar como uma string JSON ou já como um objeto.\n// Este código lida com ambos os casos.\nlet carrinhoDoCliente;\ntry {\n// Tenta converter, caso seja uma string.\ncarrinhoDoCliente = (typeof $json.carrinho_json === 'string') ? JSON.parse($json.carrinho_json) : $json.carrinho_json;\n} catch (e) {\n// Se der erro na conversão, assume um carrinho vazio.\ncarrinhoDoCliente = [];\n}\n\n// Chama a função para formatar o carrinho.\nconst textoFormatado = formatarCarrinhoEmLinha(carrinhoDoCliente);\n\n// Adiciona o resultado à saída do nó para ser usado nos nós seguintes.\n$json.carrinho_em_linha = textoFormatado;\n\n// Retorna o item com a nova propriedade.\nreturn $json;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[672,0],"id":"cf8ff199-b2bc-413e-814b-f260e2aced84","name":"formata carrinho"},{"parameters":{"httpMethod":"POST","path":"pedido_enviado","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[96,256],"id":"5a8685fd-6276-46b8-a875-f451d3bf1305","name":"Webhook","webhookId":"f0bf1004-1f51-43bd-a21d-bbc014b52740"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"3d7ddc31-5362-42a7-b07e-3dc15a327b5f","leftValue":"={{ $json.body.messages[0].content.trim() }}","rightValue":"✅ PAGAMENTO EFETUADO ✅","operator":{"type":"string","operation":"contains"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[256,464],"id":"1dcb87f2-c067-448f-8e1b-1cfe98602357","name":"If1","disabled":true},{"parameters":{},"type":"n8n-nodes-base.noOp","typeVersion":1,"position":[496,448],"id":"b1431611-3a00-4708-8fa9-3fa6e773a1ad","name":"No Operation, do nothing2","disabled":true},{"parameters":{"assignments":{"assignments":[{"id":"6e0cdb30-893a-495e-9dd4-092976c04e11","name":"id_faturamento","value":"={{ $('busca faturamento do dia').first().json.id }}","type":"string"},{"id":"9db85678-8f97-4f86-9263-e21982d18a40","name":"Canal","value":"WhatsApp","type":"string"},{"id":"a02df9c1-5bf1-4fdf-aded-89f35d10096e","name":"id_cliente","value":"={{ $json.id }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[2144,0],"id":"4c7048a2-0278-4359-87b5-ab25b16c3525","name":"pega ids"},{"parameters":{"jsCode":"// Este código extrai apenas o ID e a quantidade de cada item do carrinho.\n\n// 1. Pega os dados de entrada.\n// Supondo que os dados chegam de um nó anterior, como o \"Postgres: Consultar Estado\".\nconst estadoAtual = $json; // ou $items(\"Seu Nó Anterior\")[0].json;\n\n// 2. Pega a string do carrinho_json e a transforma em um objeto JavaScript (array).\nconst carrinho = estadoAtual.carrinho_json || [];\n\n// 3. Verifica se o carrinho não está vazio.\nif (!carrinho || carrinho.length === 0) {\n  // Se estiver vazio, retorna um array vazio para não quebrar o fluxo.\n  return [];\n}\n\n// 4. Usa o método .map() para criar um NOVO array contendo apenas o id e a qtd.\nconst itensExtraidos = carrinho.map(item => {\n  return {\n    id_original: item.id,\n    quantidade: item.qtd\n  };\n});\n\n// 5. Retorna o novo array com os dados extraídos.\n// O n8n irá dividir isso em múltiplos itens se o próximo nó não estiver configurado para lidar com arrays.\nreturn itensExtraidos;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[880,0],"id":"7f2921ef-afd7-4018-a7d5-0756ec08a743","name":"Code"},{"parameters":{"fieldsToSummarize":{"values":[{"aggregation":"sum","field":"quantidade"}]},"options":{}},"type":"n8n-nodes-base.summarize","typeVersion":1.1,"position":[1104,0],"id":"52541eec-bc5f-4573-91b9-9c1844902d78","name":"Summarize"},{"parameters":{"operation":"executeQuery","query":"UPDATE conversas_bot\nSET\n    print_carrinho = NULL,\n    estado_conversa = 'cliente_existe',\n    carrinho_json = '[]'::jsonb,\n    mapa_id_json = '{}'::jsonb,\n    pagina_atual = 1,\n    categoria_selecionada = NULL,\n    expirando = FALSE,\n    valor_pedido = NULL,\n    ultima_interacao = NOW(),\n    is_bot_paused = TRUE\nWHERE\n    jid = '{{ $('Dados Fluxo de Caixa').first().json.Jid }}'","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[3424,0],"id":"e2a1f9e5-2c71-4c6e-966b-7affe4602b54","name":"atualiza_cliente","credentials":{"postgres":{"id":"yOeDpA5WGlK3MxCC","n