{"id":"GuyhvgZRGESe5GAG","name":"0. Status_Loja","active":false,"activeVersionId":null,"createdAt":"2026-07-19T18:55:16.533Z","updatedAt":"2026-08-06T03:05:29.685Z","isArchived":false,"versionId":"f5ed7aa9-08c6-45af-8633-a04ccdf206ab","triggerCount":1,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":10}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-1376,384],"id":"faba471f-41cd-4091-84bb-9698dea74225","name":"Schedule Trigger"},{"parameters":{"jsCode":"/**\n\n * Verifica se a loja está aberta com base na hora atual, considerando o fuso horário de São Paulo.\n\n *\n\n * FORMATO DE HORÁRIO ESPERADO: número no padrão \"HH.MM\" (ex: 11.30 = 11h30, NÃO 11h18).\n\n * A parte decimal é lida como minutos, não como fração de hora.\n\n * Atenção ao cadastrar no Notion: sempre use 2 dígitos após o ponto (ex: 11.05, não 11.5),\n\n * senão há risco de digitação ambígua na hora de cadastrar.\n\n *\n\n * PENDENTE: este código ainda NÃO considera property_status_manual / property_motivo_fechamento.\n\n * Um fechamento manual no Notion será sobrescrito pelo cálculo automático abaixo.\n\n *\n\n * @returns {boolean} true se a loja estiver aberta, false caso contrário.\n\n */\n\nfunction verificarSeLojaEstaAberta() {\n  const fusoHorario = 'America/Sao_Paulo';\n  const agora = DateTime.now().setZone(fusoHorario);\n  const diaDaSemana = agora.weekday; // 1=Segunda ... 7=Domingo\n  const minutosAtual = agora.hour * 60 + agora.minute;\n  const props = $input.first().json;\n\n\n  // Converte um valor no formato \"HH.MM\" (número) para minutos desde meia-noite.\n\n  // Retorna null se o campo for null/undefined (= não há esse turno nesse dia).\n  function paraMinutos(valor, nomeCampo) {\n    if (valor === null || valor === undefined) return null;\n    if (typeof valor !== 'number') {\n      throw new Error(`Campo \"${nomeCampo}\" deveria ser número, recebeu: ${typeof valor} (${JSON.stringify(valor)})`);\n    }\n    const horas = Math.trunc(valor);\n    const minutos = Math.round((valor - horas) * 100);\n    if (minutos < 0 || minutos > 59 || horas < 0 || horas > 23) {\n      throw new Error(`Valor de horário fora do esperado em \"${nomeCampo}\": ${valor}`);\n    }\n    return horas * 60 + minutos;\n  }\n\n  // Define quais campos do Notion formam cada turno, e em quais dias da semana ele vale.\n\n  // Para adicionar um turno novo (ex: feriado), basta adicionar uma linha aqui.\n  const definicoesDeTurno = [\n    { dias: [1, 2, 3, 4, 5], campoInicio: 'property_abertura_manh_hora', campoFim: 'property_fechamento_manh_hora' },\n    { dias: [1, 2, 3, 4, 5], campoInicio: 'property_abertura_noite_hora', campoFim: 'property_fechamento_noite_hora' },\n    { dias: [6, 7], campoInicio: 'property_abertura_fs_manh_hora', campoFim: 'property_fechamento_fs_manh_hora' },\n    { dias: [6, 7], campoInicio: 'property_abertura_fs_noite_hora', campoFim: 'property_fechamento_fs_noite_hora' },\n\n  ];\n\n  // Monta os turnos válidos para o dia de hoje, ignorando os que estiverem null (não configurados).\n  const turnosDeHoje = definicoesDeTurno\n    .filter((def) => def.dias.includes(diaDaSemana))\n    .map((def) => ({\n      inicio: paraMinutos(props[def.campoInicio], def.campoInicio),\n      fim: paraMinutos(props[def.campoFim], def.campoFim),\n    }))\n    .filter((turno) => turno.inicio !== null && turno.fim !== null);\n\n  // Verifica se o horário atual cai em algum turno de hoje.\n  for (const { inicio, fim } of turnosDeHoje) {\n    const abertoNesteTurno =\n      fim > inicio\n        ? minutosAtual >= inicio && minutosAtual < fim // turno normal\n        : minutosAtual >= inicio || minutosAtual < fim; // turno cruza a meia-noite\n    if (abertoNesteTurno) return true;\n  }\n  return false;\n}\n\n\n\n// --- Como usar no seu fluxo n8n ---\nconst lojaAberta = verificarSeLojaEstaAberta();\n$json.loja_esta_aberta = lojaAberta;\n$json.status_loja_texto = lojaAberta ? \"Aberta\" : \"Fechada\";\nreturn $json; "},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-672,96],"id":"1abcff68-8cbc-4fc9-a3b4-7f28af5b85df","name":"Code in JavaScript","retryOnFail":true},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.loja_esta_aberta }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true},"id":"44ef5c11-dccb-4729-b291-010ac9a0636d"}],"combinator":"and"},"renameOutput":true,"outputKey":"Loja Aberta"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"ac83e4bc-c23a-438e-8d62-f2882f31faba","leftValue":"={{ $json.loja_esta_aberta }}","rightValue":"","operator":{"type":"boolean","operation":"false","singleValue":true}}],"combinator":"and"},"renameOutput":true,"outputKey":"Loja Fechada"}]},"options":{}},"type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[-224,96],"id":"97387fba-71ad-4863-98e6-74eba5146f33","name":"Switch"},{"parameters":{"resource":"databasePage","operation":"getAll","databaseId":{"__rl":true,"value":"2357a7a8-79af-8065-b815-c6f88bc3c5bb","mode":"list","cachedResultName":"_Loja","cachedResultUrl":"https://www.notion.so/2357a7a879af8065b815c6f88bc3c5bb"},"returnAll":true,"filterType":"manual","matchType":"allFilters","filters":{"conditions":[{"key":"!|formula","condition":"does_not_equal","returnType":"checkbox","checkboxValue":true}]},"options":{}},"type":"n8n-nodes-base.notion","typeVersion":2.2,"position":[-1152,384],"id":"a6e10922-b110-44c1-b2f4-a32c0e4f4732","name":"busca status loja","credentials":{"notionApi":{"id":"vIevXLmWaO4BFYFE","name":"Notion account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"ae498cef-a7fb-45fb-a7cf-9a237c04840b","leftValue":"={{ $json.property_status_manual }}","rightValue":"Auto","operator":{"type":"string","o